[Unit]
Description=WMS GSP controlled PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wms-gsp
Group=wms-gsp
EnvironmentFile=/etc/wms-gsp/backup.env
ExecStart=/opt/wms-gsp/scripts/backup-postgres.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/wms-gsp /mnt/wms-gsp-offsite /var/lib/wms-gsp/alerts

