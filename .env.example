APP_ENV=development
DATABASE_URL=postgresql://warehouse_user:change-me@localhost:5432/warehouse_db
SECRET_KEY=replace-with-at-least-32-random-characters
SECRETS_PROVIDER=development
SECRET_KEY_VERSION_REF=
DATABASE_CREDENTIAL_VERSION_REF=
LDAP_CREDENTIAL_VERSION_REF=
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
AUTO_CREATE_SCHEMA=true

LDAP_SERVER=ldap://127.0.0.1:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_ADMIN_DN=
LDAP_ADMIN_PASSWORD=
LDAP_USER_SEARCH_FILTER=(sAMAccountName={})
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_TLS_VALIDATE=true
LDAP_CA_CERT_FILE=
# 仅在目录服务不支持 TLS 且已完成风险批准时开启；密码会以明文经过网络。
LDAP_ALLOW_PLAINTEXT_AUTH=false

LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
